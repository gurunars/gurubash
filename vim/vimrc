" Load plugins
:filetype indent on
:filetype on
:filetype plugin on

" Change leader commands character
:let mapleader = ","

" Indentation
:set smartindent                    "turn on smart indentation
:set tabstop=4                      "set tab character to 4 characters
:set expandtab                      "enter spaces when tab is pressed
:set shiftwidth=4                   "indent width for autoindent
:set softtabstop=4
:set autoindent                     "copy indent from current line when starting a new line

" Spaces/tabs highlighting
:hi ExtraSpaces ctermbg=DarkMagenta ctermfg=DarkMagenta guibg=DarkMagenta guifg=DarkMagenta
:match ExtraSpaces /\s\+\%#\@<!$/

:hi Tabs ctermbg=DarkRed ctermfg=DarkRed guibg=DarkMagenta guifg=DarkMagenta
:2match Tabs /\t/

" Highlight search results
:set hlsearch

" Configure search
" smart case sensitivity
:set ignorecase
:set smartcase
" smart replacement
:set gdefault
" handy highlighting
:set incsearch
:set showmatch
" stop highlighting
:nnoremap <leader><space> :noh<cr>

" Handline line lengths
:set textwidth=120
:set formatoptions=qrn1
:let w:m2=matchadd('ErrorMsg', '\%>120v.\+', -1)
augroup LongLines
    autocmd!
    autocmd BufWinEnter * let w:m2=matchadd('ErrorMsg', '\%>120v.\+', -1)
augroup END

" Shortcut for toggling paste mode TODO: automate it
:set pastetoggle=<F3>

" Most frequent typo ; instad of :
:nnoremap ; :

" Misc
:set scrolloff=3                    " have 3 lines of offset (or buffer) when scrolling
:set statusline=%F%m%r%h%w\ [TYPE=%Y]\ [POS=%04l,%04v][%p%%]\ [LEN=%L] "Informative status line
:set laststatus=2 " make sure that the status line is shown
:set backspace=indent,eol,start     " Make backspaces more powerfull
:set ruler                          " show line and column number
:syntax on                          " syntax highlighting
:set showcmd                        " show (partial) command in status line

" Highlight current cursor location (fucking handy)
:hi CursorLine   cterm=NONE ctermbg=DarkBlue ctermfg=white guibg=DarkBlue guifg=white
:hi CursorColumn cterm=NONE ctermbg=DarkBlue ctermfg=white guibg=DarkBlue guifg=white
:nnoremap <Leader>c :set cursorline! cursorcolumn!<CR>

" No f@cking swap file!!!
:set noswapfile

" Redraw higlighting when exiting insert mode
augroup RedrawOnInsertLeave
    autocmd!
    autocmd InsertLeave * redraw!
augroup END

" Remove trailing spaces by clicking F5
:nnoremap <silent> <F5> :let _s=@/<Bar>:%s/\s\+$//e<Bar>:let @/=_s<Bar>:nohl<CR>

" Custom aliases
cnoreabbrev W w
cnoreabbrev Wq wq
cnoreabbrev Q q

" Line swapping
:noremap <c-up> :m .-2<CR>
:noremap <c-down> :m .+1<CR>

" Disable replace mode (tired of it)
function! s:ForbidReplace()
    if v:insertmode!=#'i'
        call feedkeys("\<Insert>", "n")
    endif
endfunction
augroup ForbidReplaceMode
    autocmd!
    autocmd InsertEnter  * call s:ForbidReplace()
    autocmd InsertChange * call s:ForbidReplace()
augroup END

" For git rebase interactive (fixup the commit on a current line).
" Buffer-local to rebase todo files, so e, f and r keep their vim meaning elsewhere.
augroup GitRebaseMotions
    autocmd!
    autocmd FileType gitrebase nnoremap <buffer> f :s/pick/f/<CR>
    autocmd FileType gitrebase nnoremap <buffer> r :s/pick/r/<CR>
    autocmd FileType gitrebase nnoremap <buffer> e :s/pick/e/<CR>
augroup END

" Toggle numbers
:nnoremap <silent> <F6> :set number!<CR>
