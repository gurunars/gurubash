#!/bin/bash
# Sourced by every shell, repeatedly (nested shells inherit PATH). Everything
# here must be idempotent: path_add skips what is already on PATH.

# path_add [-p] DIR: append DIR to PATH (prepend with -p); only if it is a
# directory and not already present.
path_add() {
    local front=0
    if [ "$1" = "-p" ]; then front=1; shift; fi
    [ -d "$1" ] || return 0
    case ":${PATH}:" in
        *":$1:"*) return 0 ;;
    esac
    if [ "$front" = 1 ]; then
        PATH="$1${PATH:+:${PATH}}"
    else
        PATH="${PATH:+${PATH}:}$1"
    fi
    export PATH
}

# Only a login shell needs /etc/profile; macOS's path_helper reorders PATH on
# it, so it goes first, before anything is added.
if shopt -q login_shell; then
    . /etc/profile
fi

OS=$(bash "${GURUBASH}/core/pkg-manager/get-os.sh")

for loader in "${GURUBASH}"/core/*/loader; do
    [ -f "${loader}" ] && . "${loader}"
done

for loader in "${GURUBASH}"/core/*/loader."${OS}"; do
    [ -f "${loader}" ] && . "${loader}"
done

for bins in "${GURUBASH}"/core/*/bins "${GURUBASH}"/core/*/bins/"${OS}"; do
    path_add "${bins}"
done

# Extensions named one per line in default-extensions; absent means none. Read on
# fd 3, so a loader reading stdin cannot eat the list.
extensions_file="${HOME}/.config/gurubash/default-extensions"
if [ -f "${extensions_file}" ]; then
    while read -r extension <&3 || [ -n "${extension}" ]; do
        [ -n "${extension}" ] || continue
        extension_dir="${GURUBASH}/extensions/${extension}"
        case "${extension}" in
            */* | . | ..) extension_dir= ;;
        esac
        if [ -z "${extension_dir}" ] || [ ! -d "${extension_dir}" ]; then
            echo "gurubash: unknown extension '${extension}' in ${extensions_file}" >&2
            continue
        fi
        for loader in "${extension_dir}/loader" "${extension_dir}/loader.${OS}"; do
            [ -f "${loader}" ] && . "${loader}"
        done
        path_add "${extension_dir}/bins"
        path_add "${extension_dir}/bins/${OS}"
    done 3<"${extensions_file}"
fi

unset loader bins extensions_file extension extension_dir
unset -f path_add
