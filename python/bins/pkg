#!/usr/bin/env python

import argparse
import os


def main():
    parser = argparse.ArgumentParser(description="Create Python package")
    parser.add_argument("name")
    args = parser.parse_args()

    print(f"Creating Python package {args.name}")
    os.makedirs(args.name, exist_ok=True)
    # "a" creates each empty file if missing and never truncates one that exists.
    for module in ("__init__.py", "tests.py"):
        with open(os.path.join(args.name, module), "a"):
            pass


if __name__ == "__main__":
    main()