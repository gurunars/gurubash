[color]
  ui = true
[color "branch"]
  current = yellow reverse
  local = yellow
  remote = green
[color "diff"]
  meta = yellow bold
  frag = magenta bold
  old = red bold
  new = green bold
  whitespace = red reverse
[color "status"]
  added = yellow
  changed = green
  untracked = cyan
[core]
  whitespace = trailing-space,space-before-tab
[apply]
  whitespace = fix
[alias]
  cl = clean -fdx
  st = status
  tree = log --oneline --decorate --all --graph
  ci = commit --no-verify
  br = branch
  ch = checkout
  df = diff --color-words
  lg = log --pretty=format:'%Cgreen%h%Creset %s%d %Cred%cn @ %cd ' --date=short
[credential]
  helper = cache
[includeIf "gitdir:~/repo/"]
  path = ~/repo/gitconfig
[includeIf "gitdir:~/work/"]
  path = ~/work/gitconfig
[init]
  defaultBranch = master
