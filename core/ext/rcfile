#!/bin/bash
# --rcfile of the shell `ext use` starts: the user's usual startup, then every
# extension named in GURUBASH_EXT. Nothing is written anywhere: leaving the shell
# frees it all.
[ -f "${HOME}/.bashrc" ] && . "${HOME}/.bashrc"
[ -n "${OS:-}" ] || OS=$(bash "${GURUBASH}/core/pkg-manager/get-os.sh")
. "${GURUBASH}/core/ext/loader"
_ext_load_active
GURUBASH_EXT_LAYER=1   # not exported: only this shell is a layer, its children are not
export GURUBASH_EXT
