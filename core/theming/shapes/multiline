#!/bin/bash
# shellcheck disable=SC2154 # colours are set by bash_color_definitions and the theme, sourced first
if [ "$EUID" -eq 0 ];then
  usercolor=$croot
else
  usercolor=$cuser
fi

PS1="\$(surprise)\
\[$cbracket\][\[$ctime\]\A\[$cbracket\]]\
\[$cbracket\][\[$usercolor\]\u$Color_Off\[$cdog\]@\[$chost\]\h\[$cbracket\]][\[$cpath\]\w\[$cbracket\]]\
\$(branch)\
\$(aws_assumed_role)\
\$(ext_active)\
\n\
\[$ccursor\] > \[$Color_Off\]"
